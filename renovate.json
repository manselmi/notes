{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "abandonmentThreshold": "1 year",
  "automerge": true,
  "dependencyDashboard": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* * * * 0"
    ]
  },
  "packageRules": [
    {
      "matchDepTypes": [
        "action"
      ],
      "pinDigests": true
    },
    {
      "matchDepTypes": [
        "*"
      ],
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all"
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ],
  "platformCommit": "enabled",
  "postUpgradeTasks": {
    "commands": [
      "mise run sync-hk-pkl-version"
    ],
    "fileFilters": [
      "hk.pkl"
    ]
  },
  "rebaseWhen": "behind-base-branch",
  "schedule": [
    "* * * * 1-6"
  ],
  "separateMajorMinor": false
}
