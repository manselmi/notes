{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": null
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    }
  ],
  "platformCommit": "enabled",
  "postUpgradeTasks": {
    "commands": [
      "mise run sync-hk-pkl-version"
    ],
    "fileFilters": [
      "hk.pkl"
    ]
  },
  "separateMajorMinor": false
}
